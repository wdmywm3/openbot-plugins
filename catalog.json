    {
      "id": "content-monitor",
      "name": "内容监控",
      "version": "1.0.1",
      "description": "后台监控 Bilibili UP 主和 RSS/Atom Feed，并主动推送到指定 QQ 会话",
      "category": "utility",
      "main": "index.js",
      "permissions": [
        "reply",
        "state",
        "network",
        "push",
        "secret"
      ],
      "metadata": {
        "usage": "/monitorresolve 核对聊天记录后确认或重试结果不明的推送\n/monitorstatus 查看内容监控状态\n/monitorcheck 立即执行一次内容检查",
        "platforms": [
          "napcat",
          "qqbot"
        ],
        "requirements": [],
        "changelog": "支持官方 QQ 会话 ID；未发送的消息保留待办，结果不明的消息暂停重试；恢复后清除旧错误。 监控进度按订阅保存到插件专属数据库，继承待确认推送，避免迁移后重复发送。",
        "components": [
          "commands",
          "background"
