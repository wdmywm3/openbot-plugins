    {
      "id": "dice-maiden",
      "name": "骰娘",
      "version": "1.3.2",
      "description": "通用/暗骰、丰富骰式、CoC 7 版检定、对抗检定、角色卡和疯狂症状",
      "category": "entertainment",
      "main": "index.js",
      "permissions": [
        "reply",
        "state",
        "napcat:send_private_msg"
      ],
      "metadata": {
        "usage": "/roll 通用掷骰，例如 .d50、.rd50、.rd 50、/r2d6+1 攻击或 .r3#d20\n/ra CoC 7 版检定，例如 .ra 侦查 60 或 .ra b1 侦查\n/rh 暗骰；群聊中将结果私聊发送给掷骰者\n/rav CoC 对抗检定，例如 .rav 侦查 60 潜行 45\n/coc 兼容的 CoC 百分骰检定，例如 /coc 60 b1\n/sc 理智检定，例如 .sc 1/1d6 60\n/st 设置或查看本群角色卡，例如 .st 侦查 60 SAN 70\n/en CoC 技能成长检定，例如 .en 侦查\n/ti 抽取临时疯狂症状\n/li 抽取总结性疯狂症状\n/cocchar 生成 CoC 7 版角色属性\n/d20 D20 优势或劣势检定，例如 /d20 adv +3；直接 .d20 会返回基础骰点\n/dset 设置当前群或私聊的默认骰式\n/dicestats 查看当前群或私聊的掷骰统计\n/dicehelp 查看骰娘命令",
        "platforms": [
          "napcat",
          "qqbot"
        ],
        "requirements": [
          "统计需要支持 api.updateState 的 OpenBot 版本；从群聊发送私聊暗骰仅支持 NapCat"
        ],
        "changelog": "更新插件市场分类。",
        "components": [
          "commands"
        ],
        "hasBackgroundAgent": false
      },
