{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "android-roamer",
  "version": "4.0.0",
  "description": "让 Bot 读取已绑定安卓设备的屏幕、查看应用并执行指定的手机操作",
  "extensions": {
    "com.openbot": {
      "main": "index.js",
      "category": "ai",
      "permissions": [
        "agent",
        "memory:read",
        "memory:write",
        "retrieval",
        "hook:context",
        "state",
        "reply",
        "mcp",
        "assets",
        "state:global",
        "script:run"
      ],
      "hooks": [
        {
          "type": "context",
          "export": "context",
          "tools": [
            "useSkill"
          ],
          "scope": "all",
          "permission": "member"
        }
      ],
      "commands": [
        {
          "name": "phone",
          "aliases": [
            "手机任务"
          ],
          "description": "让当前 Bot 使用手机完成交办事项",
          "scope": "private",
          "permission": "owner",
          "responseMode": "agent"
        },
        {
          "name": "phonestatus",
          "description": "查看当前主人私聊中的手机任务",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "phoneresume",
          "description": "让当前 Bot 核对历史和设备画面后继续",
          "scope": "private",
          "permission": "owner",
          "responseMode": "agent"
        },
        {
          "name": "roam",
          "aliases": [
            "手机闲逛"
          ],
          "description": "让当前 Bot 按兴趣使用手机",
          "scope": "private",
          "permission": "owner",
          "responseMode": "agent"
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "useEnabled": {
            "type": "boolean",
            "title": "按需使用手机",
            "scope": "instance",
            "default": true
          },
          "prohibitions": {
            "type": "string",
            "title": "不希望做的事",
            "default": "",
            "ui": {
              "widget": "multiline"
            }
          },
          "allApps": {
            "type": "boolean",
            "title": "使用手机上的所有应用",
            "scope": "instance",
            "default": true,
            "ui": {
              "advanced": true
            }
          },
          "playApps": {
            "type": "array",
            "title": "指定应用包名",
            "items": {
              "type": "string",
              "pattern": "^(?=.{3,255}$)[A-Za-z][A-Za-z0-9_.]*\\.[A-Za-z0-9_]+$"
            },
            "default": [],
            "ui": {
              "advanced": true,
              "when": {
                "field": "allApps",
                "equals": false
              }
            },
            "scope": "instance"
          }
        }
      },
      "displayName": "bPhone",
      "tools": [
        {
          "name": "use",
          "description": "观察手机：读取当前控件、截图或列出应用，返回结果供你决定下一步。旧调用只给 goal 时仅读屏。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可设 true；默认 false，用于 Bot 自己的公开活动。"
              },
              "operation": {
                "type": "string",
                "enum": [
                  "observe",
                  "screenshot",
                  "apps"
                ]
              },
              "goal": {
                "type": "string",
                "maxLength": 2000
              },
              "activityId": {
                "type": "string",
                "maxLength": 160,
                "description": "继续活动列表中的指定活动。"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "act",
          "description": "执行一项由你选定的手机动作。携带刚读屏得到的 observationId，每个编号只能操作一次。设备返回后由你判断结束或重新观察。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可设 true；默认 false，用于 Bot 自己的公开活动。"
              },
              "observationId": {
                "type": "string",
                "maxLength": 64
              },
              "action": {
                "type": "string",
                "enum": [
                  "tap",
                  "longpress",
                  "swipe",
                  "back",
                  "home",
                  "rotate",
                  "type",
                  "fill",
                  "launch",
                  "terminate"
                ]
              },
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "toX": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "toY": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16384
              },
              "text": {
                "type": "string",
                "maxLength": 2000
              },
              "app": {
                "type": "string",
                "maxLength": 255
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "portrait",
                  "landscape"
                ]
              }
            },
            "required": [
              "action",
              "observationId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "script",
          "title": "执行手机脚本",
          "description": "由你编写一次 JavaScript 函数体，按每次实际读到的画面连续操作。变量 screen、step、state；返回 {tap:{text:\"设置\"}}、{act:{action:\"back\"}}、{done:结果} 或 {stop:\"原因\"}。观察编号由工具逐步绑定。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可设 true；默认 false，用于 Bot 自己的公开活动。"
              },
              "code": {
                "type": "string",
                "maxLength": 8192,
                "description": "每次读屏后执行的 JavaScript 函数体。step 为已确认动作数，从 0 开始。可随动作返回 state。"
              },
              "maxActions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16,
                "description": "本次最多执行的设备动作数，默认 8。纯查询填 0。"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "status",
          "description": "只读查询手机活动、经历总结或逐次轨迹；trajectory:true列出轨迹，eventId读详情。私人记录仅限主人原私聊。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "listDevices": {
                "type": "boolean"
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "private": {
                "type": "boolean",
                "description": "仅主人当前私聊可查询私人任务。"
              },
              "activities": {
                "type": "boolean",
                "description": "列出这台手机保存的各项活动。"
              },
              "notes": {
                "type": "boolean",
                "description": "读取 activityId 对应的 Markdown 经历总结；offset 可继续读取。"
              },
              "activityId": {
                "type": "string",
                "maxLength": 160
              },
              "cursor": {
                "type": "string",
                "maxLength": 1000
              },
              "trajectory": {
                "type": "boolean",
                "description": "查询这台手机的逐次活动轨迹，按activityId筛选，cursor翻页。"
              },
              "eventId": {
                "type": "string",
                "maxLength": 256,
                "description": "trajectory:true时读取指定记录的完整正文和关键步骤。"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "resume",
          "description": "恢复观察：读取当前屏幕并返回新的观察编号。请根据当前画面自行决定下一步。",
          "export": "agentTool",
          "scope": "private",
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "private": {
                "type": "boolean"
              },
              "activityId": {
                "type": "string",
                "maxLength": 160,
                "description": "继续活动列表中的指定活动。"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "record",
          "description": "保存你撰写的手机活动总结和有依据的经验，不操作设备。同一活动可携带已有 activityId。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128,
                "description": "手机编号或名称；未指定时用默认或唯一手机，多台无默认先询问。"
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可设 true；默认 false，用于 Bot 自己的公开活动。"
              },
              "activityId": {
                "type": "string",
                "maxLength": 160
              },
              "goal": {
                "type": "string",
                "maxLength": 2000
              },
              "report": {
                "type": "string",
                "maxLength": 2000
              },
              "progress": {
                "type": "string",
                "maxLength": 1000
              },
              "next": {
                "type": "string",
                "maxLength": 600
              },
              "blocked": {
                "type": "string",
                "maxLength": 600
              },
              "reflections": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "topic": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "understanding": {
                      "type": "string",
                      "maxLength": 1200
                    },
                    "application": {
                      "type": "string",
                      "maxLength": 800
                    },
                    "uncertainty": {
                      "type": "string",
                      "maxLength": 600
                    },
                    "evidence": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "sourceId": {
                            "type": "string",
                            "maxLength": 160
                          },
                          "quote": {
                            "type": "string",
                            "maxLength": 600
                          }
                        },
                        "required": [
                          "sourceId",
                          "quote"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "topic",
                    "understanding",
                    "evidence",
                    "application"
                  ],
                  "additionalProperties": false
                }
              },
              "questions": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "question": {
                      "type": "string",
                      "maxLength": 600
                    }
                  },
                  "required": [
                    "sourceId",
                    "question"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "goal",
              "report"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "learning",
          "description": "按主题检索经验、查阅来源与修订历史，或列出待解决问题。",
          "export": "agentTool",
          "scope": "all",
          "permission": "member",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "query",
                  "get",
                  "history",
                  "questions"
                ]
              },
              "query": {
                "type": "string",
                "maxLength": 1000
              },
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "cursor": {
                "type": "string",
                "maxLength": 1000
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可读取私人任务经验。"
              }
            },
            "additionalProperties": false
          }
        },
        {
          "name": "revise_learning",
          "description": "根据已保存的来源修订经验，或撤回过时认识；先读取当前版本。",
          "export": "agentTool",
          "scope": "private",
          "permission": "owner",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "revise",
                  "retract"
                ]
              },
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 0
              },
              "topic": {
                "type": "string",
                "maxLength": 160
              },
              "understanding": {
                "type": "string",
                "maxLength": 1200
              },
              "application": {
                "type": "string",
                "maxLength": 800
              },
              "uncertainty": {
                "type": "string",
                "maxLength": 600
              },
              "evidence": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "quote": {
                      "type": "string",
                      "maxLength": 600
                    }
                  },
                  "required": [
                    "sourceId",
                    "quote"
                  ],
                  "additionalProperties": false
                }
              },
              "private": {
                "type": "boolean",
                "description": "仅主人私聊可读取私人任务经验。"
              }
            },
            "required": [
              "action",
              "id",
              "expectedRevision"
            ],
            "additionalProperties": false
          }
        }
      ],
      "ui": {
        "version": 2,
        "layout": "settings",
        "sections": [
          {
            "id": "settings",
            "title": "使用设置",
            "fields": [
              "useEnabled",
              "prohibitions",
              "allApps",
              "playApps"
            ]
          }
        ],
        "labels": {
          "settings": "使用设置",
          "save": "保存使用设置"
        },
        "views": [
          {
            "id": "devices",
            "title": "设备",
            "entry": "ui/devices.html",
            "actions": [
              "devices"
            ]
          }
        ]
      },
      "actions": [
        {
          "id": "activity",
          "title": "查看近况",
          "kind": "native",
          "export": "inspectActivity",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "maxLength": 128
              }
            },
            "required": [
              "deviceId"
            ],
            "additionalProperties": false
          },
          "resultTemplate": "{summary}"
        },
        {
          "id": "devices",
          "title": "设备管理",
          "kind": "native",
          "export": "deviceSettings",
          "readOnly": false,
          "inputSchema": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "list",
                  "scan",
                  "preview",
                  "save",
                  "update",
                  "remove",
                  "transfer",
                  "activity",
                  "pick",
                  "picked",
                  "history",
                  "detail"
                ]
              },
              "deviceId": {
                "type": "string",
                "maxLength": 128
              },
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "adbPath": {
                "type": "string",
                "maxLength": 1024
              },
              "host": {
                "type": "string",
                "maxLength": 64
              },
              "token": {
                "type": "string",
                "maxLength": 80
              },
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "paused": {
                "type": "boolean"
              },
              "isDefault": {
                "type": "boolean"
              },
              "connected": {
                "type": "boolean"
              },
              "settings": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "useEnabled": {
                    "type": "boolean"
                  },
                  "prohibitions": {
                    "type": "string"
                  },
                  "allApps": {
                    "type": "boolean"
                  },
                  "playApps": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^(?=.{3,255}$)[A-Za-z][A-Za-z0-9_.]*\\.[A-Za-z0-9_]+$"
                    }
                  }
                }
              },
              "target": {
                "type": "string",
                "maxLength": 128
              },
              "ticket": {
                "type": "string",
                "maxLength": 80
              },
              "cursor": {
                "type": "string",
                "maxLength": 400
              }
            },
            "additionalProperties": false
          }
        }
      ],
      "metadata": {
        "usage": "绑定设备后，在聊天中告诉 Bot 目标。Bot 可以读屏、查看截图和逐项调用手机动作。",
        "requirements": [
          "已在 Windows x64、OpenBot 0.1.119 验证",
          "配置并通过截图确认手机连接",
          "角色启用插件工具与技能"
        ],
        "changelog": "由聊天 Bot 决定每一次设备操作。新增手机脚本，可按控件文字或资源 ID 连续操作，每一步自动使用当前画面的观察编号。"
      },
      "dependencies": {
        "node": {
          "lockfile": "package-lock.json"
        }
      },
      "requiredFeatures": [
        "instanceSettingsViews",
        "mediaHandoff",
        "scriptExecution"
      ]
    }
  }
}
