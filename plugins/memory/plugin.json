{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "memory",
  "version": "2.5.0",
  "description": "为宿主统一记忆提供自动召回、梦境整理和持续事项复查。",
  "extensions": {
    "com.openbot": {
      "displayName": "记忆 Plus",
      "category": "assistant",
      "apiVersion": 1,
      "main": "index.js",
      "requiredFeatures": [
        "unifiedMemory",
        "persistentContextItems",
        "visibleContextItems",
        "sourceHead",
        "offlineBackground",
        "persistentActivities",
        "persistentAvatars",
        "instanceSettingsViews",
        "pluginNavigationV2",
        "pluginOverlays",
        "modelHookTextInput",
        "inlineContextItems",
        "hybridRetrieval",
        "sourceAttachments",
        "modelHookTimeouts",
        "pluginProcessCancellation",
        "agentContinuations",
        "memoryCategories"
      ],
      "permissions": [
        "process",
        "state",
        "sources",
        "memory:read",
        "memory:write",
        "memory:manage",
        "history",
        "retrieval",
        "model",
        "agent",
        "conversation",
        "push",
        "jobs",
        "assets",
        "hook:loaded",
        "hook:beforeModel",
        "hook:afterModel",
        "hook:replyDelivered",
        "hook:stopping",
        "prompt:system"
      ],
      "dependencies": {
        "node": {
          "lockfile": "package-lock.json"
        }
      },
      "execution": {
        "concurrency": "parallel",
        "process": {
          "protocol": 1,
          "command": "node",
          "entry": "process.cjs",
          "concurrency": 4,
          "cancellation": "cooperative"
        }
      },
      "background": {
        "export": "recover",
        "requiresConnection": false,
        "intervalSeconds": 60,
        "startupDelaySeconds": 5,
        "jitterSeconds": 5
      },
      "hooks": [
        {
          "type": "beforeModel",
          "export": "beforeModel",
          "timeoutMs": 120000,
          "inputMode": "text"
        },
        {
          "type": "afterModel",
          "export": "afterModel"
        },
        {
          "type": "replyDelivered",
          "export": "replyDelivered"
        },
        {
          "type": "stopping",
          "export": "stopping"
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "retrievalModelId": {
            "type": "string",
            "title": "检索模型",
            "default": ""
          },
          "semanticThreshold": {
            "type": "number",
            "title": "语义匹配下限",
            "default": 0.45,
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "tools": [
        {
          "name": "recall",
          "export": "recall",
          "scope": "all",
          "permission": "member",
          "mutating": false,
          "description": "默认按含义查找当前聊天有权访问的正式记忆，支持文字、图片和图文联合查询。需要查原始聊天或图片历史时设置 searchIn=chat_history，返回匹配的消息片段及编号；历史聊天资料不等于已确认记忆。按编号读记忆全文、修改或遗忘使用宿主 memory。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "searchIn": {
                "type": "string",
                "enum": [
                  "memories",
                  "chat_history"
                ],
                "description": "memories 查正式记忆（默认）；chat_history 按需查原始聊天和图片历史。"
              },
              "query": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4000
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "imageMessageId": {
                "type": "string",
                "maxLength": 200,
                "description": "可选，使用当前聊天中这条消息的图片参与检索。"
              },
              "imageIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "memory",
          "permissionAliases": [
            "memory"
          ],
          "compatibilityOnly": true,
          "export": "memory",
          "scope": "all",
          "permission": "member",
          "mutating": true,
          "description": "记住、召回、纠正、遗忘或追溯当前聊天的事实。search 可查经历、事项、话题和笔记；read 按返回的 id 读取正文与来源。只有写入返回 ok=true 才能确认已记住。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "remember",
                  "recall",
                  "revise",
                  "history",
                  "update",
                  "forget",
                  "search",
                  "read"
                ]
              },
              "query": {
                "type": "string"
              },
              "content": {
                "type": "string",
                "maxLength": 500
              },
              "memoryId": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "facts",
                  "history",
                  "records",
                  "topics",
                  "notes"
                ]
              },
              "fact": {
                "type": "object",
                "additionalProperties": true
              },
              "supersedes": {
                "type": "object",
                "additionalProperties": true
              },
              "changeType": {
                "type": "string",
                "enum": [
                  "correction",
                  "change"
                ]
              },
              "sourceQuote": {
                "type": "string"
              },
              "sourceMessageId": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "includePending": {
                "type": "boolean"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": true
          }
        },
        {
          "name": "organize",
          "export": "organize",
          "scope": "all",
          "permission": "member",
          "mutating": true,
          "description": "处理已开始的记忆整理批次：按需查询旧记忆、补读本批原文并提交有依据的提案。需要当前批次 ticket；普通聊天请用 recall 和 memory。",
          "inputSchema": {
            "type": "object",
            "properties": {
              "ticket": {
                "type": "string",
                "maxLength": 100
              },
              "operation": {
                "type": "string",
                "enum": [
                  "search",
                  "read",
                  "material",
                  "commit"
                ]
              },
              "query": {
                "type": "string",
                "maxLength": 1000
              },
              "id": {
                "type": "string",
                "maxLength": 200
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "result": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "ticket",
              "operation"
            ],
            "additionalProperties": false
          }
        }
      ],
      "actions": [
        {
          "id": "list",
          "kind": "native",
          "export": "list",
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "id": "manage",
          "kind": "native",
          "export": "manage",
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "id": "process",
          "kind": "job",
          "export": "process",
          "permission": "member",
          "restartable": true,
          "timeoutMs": 3600000,
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "id": "followup",
          "kind": "job",
          "export": "followup",
          "permission": "member",
          "restartable": false,
          "timeoutMs": 300000,
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "id": "import",
          "kind": "job",
          "export": "importBundle",
          "permission": "owner",
          "restartable": true,
          "timeoutMs": 3600000,
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      ],
      "ui": {
        "version": 2,
        "views": [
          {
            "id": "library",
            "title": "记忆整理",
            "entry": "ui/index.html",
            "actions": [
              "list",
              "manage",
              "process",
              "import"
            ]
          },
          {
            "id": "runs",
            "title": "整理记录",
            "entry": "ui/index.html",
            "actions": [
              "list",
              "manage"
            ]
          },
          {
            "id": "details",
            "title": "整理记录",
            "entry": "ui/details.html",
            "actions": [
              "manage"
            ],
            "presentation": "dialog"
          }
        ],
        "contributions": [
          {
            "id": "organizer",
            "kind": "tab",
            "mode": "add",
            "target": "instance.memory.tabs",
            "label": "整理",
            "viewId": "library",
            "choiceGroup": "placement",
            "choice": "embedded",
            "choiceLabel": "在记忆页面内显示整理（推荐）",
            "default": true
          },
          {
            "id": "plus",
            "kind": "group",
            "mode": "add",
            "target": "instance.sidebar",
            "label": "记忆 Plus",
            "choiceGroup": "placement",
            "choice": "category",
            "choiceLabel": "新建记忆 Plus 分类"
          },
          {
            "id": "organizer-page",
            "kind": "page",
            "mode": "add",
            "target": "instance.sidebar",
            "parent": "plus",
            "label": "整理",
            "viewId": "library",
            "choiceGroup": "placement",
            "choice": "category",
            "choiceLabel": "新建记忆 Plus 分类"
          },
          {
            "id": "runs-page",
            "kind": "page",
            "mode": "add",
            "target": "instance.sidebar",
            "parent": "plus",
            "label": "运行记录",
            "viewId": "runs",
            "choiceGroup": "placement",
            "choice": "category",
            "choiceLabel": "新建记忆 Plus 分类"
          }
        ]
      },
      "metadata": {
        "requirements": [
          "需要支持持续整理会话和人物画像的新版本 OpenBot；请先安装本次配套的 OpenBot 0.1.98 或更新版本，再更新插件。Node.js 24 由宿主管理。"
        ],
        "changelog": "空闲整理增量筛选，普通事实先待确认；明确记住、稳定画像与重要边界可直接生效。定时整理复审候选和已有自动记忆，支持晋升、合并与可恢复归档。逐条按聊天和成员查重，同一事实改写不再重复新增；候选有容量和时效限制，未完成事项和手写记忆受保护。"
      }
    }
  }
}
