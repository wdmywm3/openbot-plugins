{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "watch",
  "version": "0.9.0",
  "description": "通过内置浏览器在线读取画面、字幕和片段声音，也支持聊天附件、视频直链和本地文件。",
  "extensions": {
    "com.openbot": {
      "displayName": "Watch 视频阅读",
      "category": "utility",
      "permissions": [
        "history",
        "mcp",
        "browser",
        "network"
      ],
      "metadata": {
        "usage": "提供视频页面即可优先在线读取；聊天附件、直链和本地视频共用一个入口，支持分镜、字幕和按时间补看。",
        "requirements": [
          "需要 OpenBot 0.1.77 或更新版本；自动准备 Python、FFmpeg 和视频下载依赖",
          "角色启用 Skill 和插件的 MCP 工具；理解画面需要支持图片的模型",
          "无字幕时可配置本地 faster-whisper 模型进行转写"
        ],
        "changelog": "新增内置浏览器在线读取：按实际时间取帧、读取页面字幕、按需采集当前标签页音频并转写；保留附件、直链和本地文件入口。"
      },
      "dependencies": {
        "python": {
          "version": "3.12",
          "requirements": "requirements-media.lock"
        },
        "tools": [
          "ffmpeg",
          "deno"
        ]
      },
      "apiVersion": 1,
      "main": "index.js",
      "config": {
        "localVideoRoots": []
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "localVideoRoots": {
            "type": "array",
            "title": "本地视频目录",
            "description": "允许读取的本地目录或文件；聊天附件和网络视频不需要配置。",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "additionalProperties": false
      },
      "tools": [
        {
          "name": "watch_start",
          "export": "watch_start",
          "description": "读取视频：平台页面优先使用内置浏览器在线取画面和字幕；无字幕时可采集片段声音转写。在线每次最多60秒，其他来源每次最多600秒。支持附件、直链和本地文件。",
          "scope": "all",
          "permission": "member",
          "mutating": false,
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 8192,
                "description": "可在浏览器播放的视频页面、HTTP/HTTPS 视频直链、配置目录内的本地视频路径、import:<token> 或 watch:<job_id>"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "auto",
                  "direct",
                  "page"
                ],
                "description": "默认自动判断；无扩展名的视频附件直链使用 direct"
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 7200,
                "default": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 7200
              },
              "frame_count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 24,
                "default": 12
              },
              "sampling": {
                "type": "string",
                "enum": [
                  "balanced",
                  "uniform"
                ],
                "default": "balanced"
              },
              "timestamps": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 7200
                },
                "minItems": 1,
                "maxItems": 24,
                "description": "补看指定的原视频秒数；提供后替代自动选帧"
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "description": "可选。仅在整帧细节看不清时使用；x/y/width/height 按 watch_status 的原视频 media.width/height 像素计算，不能直接使用缩小后图片的坐标。不填返回完整画面。"
              },
              "request_id": {
                "type": "string",
                "description": "可选的新 UUID；仅在重试相同请求时复用，防止重复下载"
              },
              "message_id": {
                "type": "string",
                "maxLength": 200,
                "description": "当前聊天里视频附件所在的真实消息编号；与 source 二选一"
              },
              "attachment_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99,
                "description": "可选的附件序号，从0开始；默认选择第一段视频"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "browser",
                  "download"
                ],
                "default": "auto",
                "description": "auto优先在线读取平台页面；browser强制在线读取；download使用下载器。"
              },
              "tab_id": {
                "type": "string",
                "maxLength": 100,
                "description": "可选，复用当前聊天已打开的浏览器页面"
              },
              "media_id": {
                "type": "string",
                "maxLength": 100,
                "description": "可选，选择页面上已有的具体播放器"
              },
              "audio": {
                "type": "string",
                "enum": [
                  "auto",
                  "off",
                  "required"
                ],
                "default": "auto",
                "description": "无字幕时是否采集音频：auto在有转写模型时采集；off只看画面；required要求可用的语音读取。"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "watch_zoom",
          "export": "watch_zoom",
          "description": "按已有分镜编号补看细节；在线任务重新定位原页面，文件任务复用原文件。",
          "scope": "all",
          "permission": "member",
          "mutating": false,
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$",
                "description": "本任务返回的 job_id；作为读取凭证保留在原会话中"
              },
              "cell_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "frame_count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 24,
                "default": 6
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "request_id": {
                "type": "string",
                "description": "新UUID；仅重试同一补看请求时复用"
              }
            },
            "required": [
              "job_id",
              "cell_id"
            ],
            "additionalProperties": false
          }
        }
      ],
      "networkHosts": [
        "*"
      ]
    }
  }
}
