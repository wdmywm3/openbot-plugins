{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "watch",
  "version": "0.10.0",
  "description": "在线读取视频或音频，字幕优先，无字幕时本地转写；支持聊天附件、直链、本地媒体和按时间补看。",
  "extensions": {
    "com.openbot": {
      "displayName": "Watch 视频阅读",
      "category": "utility",
      "permissions": [
        "history",
        "mcp",
        "browser",
        "network"
      ],
      "metadata": {
        "usage": "提供视频页面即可优先在线读取；聊天附件、直链和本地视频共用一个入口，支持分镜、字幕和按时间补看。",
        "requirements": [
          "需要 OpenBot 0.1.78 或更新版本；自动准备 Python、FFmpeg、视频下载及本地语音转写依赖",
          "角色启用 Skill 和插件的 MCP 工具；理解画面需要支持图片的模型",
          "默认启用本地转写；无字幕时首次准备约486 MB模型，也可在配置中选择仅使用字幕"
        ],
        "changelog": "参照 claude-video 的本地流程补齐转写依赖、模型初始化与试运行；字幕优先，支持独立音频、内嵌文字字幕及仅读取文字，保留部分可用资料。"
      },
      "dependencies": {
        "python": {
          "version": "3.12",
          "requirements": "requirements-media.lock"
        },
        "tools": [
          "ffmpeg",
          "deno",
          "msvc"
        ]
      },
      "apiVersion": 1,
      "main": "index.js",
      "config": {
        "localVideoRoots": [],
        "asrBackend": "local",
        "asrLanguage": ""
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "localVideoRoots": {
            "type": "array",
            "title": "本地媒体目录",
            "description": "允许读取的本地目录或文件；聊天附件和网络视频不需要配置。",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "asrBackend": {
            "type": "string",
            "title": "无字幕时的语音读取",
            "enum": [
              "local",
              "none"
            ],
            "default": "local",
            "description": "本地转写首次使用会准备约486 MB模型，完成试运行后缓存复用；语音留在本机。",
            "ui": {
              "enumLabels": [
                "本地转写",
                "仅使用字幕"
              ]
            }
          },
          "asrLanguage": {
            "type": "string",
            "title": "口述语言",
            "default": "",
            "maxLength": 3,
            "description": "留空自动识别；识别不准时可填写 zh、en 等语言代码。此设置不选择字幕语言。"
          }
        },
        "additionalProperties": false
      },
      "tools": [
        {
          "name": "watch_start",
          "export": "watch_start",
          "description": "读取视频或音频：页面优先通过内置浏览器；字幕优先，无字幕时本地转写。支持仅读文字、附件、直链和本地文件。在线每段最多60秒，文件每段最多600秒。",
          "scope": "all",
          "permission": "member",
          "mutating": false,
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "maxLength": 8192,
                "description": "视频或音频页面、HTTP/HTTPS媒体直链、配置目录内的本地媒体路径、import:<token> 或 watch:<job_id>"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "auto",
                  "direct",
                  "page"
                ],
                "description": "默认自动判断；无扩展名的视频附件直链使用 direct"
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 7200,
                "default": 0
              },
              "end_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 7200
              },
              "frame_count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 24,
                "default": 12
              },
              "sampling": {
                "type": "string",
                "enum": [
                  "balanced",
                  "uniform"
                ],
                "default": "balanced"
              },
              "timestamps": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 7200
                },
                "minItems": 1,
                "maxItems": 24,
                "description": "补看指定的原视频秒数；提供后替代自动选帧"
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false,
                "description": "可选。仅在整帧细节看不清时使用；x/y/width/height 按 watch_status 的原视频 media.width/height 像素计算，不能直接使用缩小后图片的坐标。不填返回完整画面。"
              },
              "request_id": {
                "type": "string",
                "description": "可选的新 UUID；仅在重试相同请求时复用，防止重复下载"
              },
              "message_id": {
                "type": "string",
                "maxLength": 200,
                "description": "当前聊天里视频或音频附件所在的真实消息编号；与source二选一"
              },
              "attachment_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99,
                "description": "可选附件序号，从0开始；默认选择第一段视频或音频"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "auto",
                  "browser",
                  "download"
                ],
                "default": "auto",
                "description": "auto优先在线读取平台页面；browser强制在线读取；download使用下载器。"
              },
              "tab_id": {
                "type": "string",
                "maxLength": 100,
                "description": "可选，复用当前聊天已打开的浏览器页面"
              },
              "media_id": {
                "type": "string",
                "maxLength": 100,
                "description": "可选，选择页面上已有的具体播放器"
              },
              "audio": {
                "type": "string",
                "enum": [
                  "auto",
                  "off",
                  "required"
                ],
                "default": "auto",
                "description": "auto无字幕时按主人配置进行本地转写；off不读取声音；required要求明确报告语音是否取得。"
              },
              "detail": {
                "type": "string",
                "enum": [
                  "balanced",
                  "transcript"
                ],
                "default": "balanced",
                "description": "balanced读取画面和文字；transcript仅读取字幕或语音，有字幕时可跳过下载。"
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "watch_zoom",
          "export": "watch_zoom",
          "description": "按已有分镜编号补看细节；在线任务重新定位原页面，文件任务复用原文件。",
          "scope": "all",
          "permission": "member",
          "mutating": false,
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$",
                "description": "本任务返回的 job_id；作为读取凭证保留在原会话中"
              },
              "cell_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24
              },
              "frame_count": {
                "type": "integer",
                "minimum": 2,
                "maximum": 24,
                "default": 6
              },
              "crop": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "y": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 16384
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 16384
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "request_id": {
                "type": "string",
                "description": "新UUID；仅重试同一补看请求时复用"
              }
            },
            "required": [
              "job_id",
              "cell_id"
            ],
            "additionalProperties": false
          }
        }
      ],
      "networkHosts": [
        "*"
      ]
    }
  }
}
