{
  "mcpServers": {
    "watch": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-B",
        "-u",
        "${PLUGIN_ROOT}/tools/server.py",
        "--data-dir",
        "${PLUGIN_DATA}",
        "--host-bridge"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "native_tools": [
        "watch_start",
        "watch_zoom",
        "watch_ingest",
        "watch_browser"
      ],
      "enabled_tools": [
        "watch_preview",
        "watch_info",
        "watch_status",
        "watch_storyboard",
        "watch_frames",
        "watch_transcript",
        "watch_cancel",
        "watch_media"
      ]
    }
  }
}
