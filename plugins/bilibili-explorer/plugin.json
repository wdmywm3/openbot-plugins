{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "bilibili-explorer",
  "version": "1.11.0",
  "description": "浏览 B 站、互动与分享，管理收藏并保留阅读笔记",
  "extensions": {
    "com.openbot": {
      "main": "./index.js",
      "category": "automation",
      "permissions": [
        "agent",
        "state",
        "push",
        "reply",
        "network",
        "secret",
        "share",
        "media",
        "browser",
        "browser:write",
        "hook:context"
      ],
      "background": {
        "agent": true,
        "export": "poll",
        "intervalSeconds": 60,
        "startupDelaySeconds": 20,
        "jitterSeconds": 5
      },
      "hooks": [
        {
          "type": "context",
          "export": "context",
          "tools": [
            "channelPlugin",
            "useSkill"
          ],
          "scope": "all",
          "permission": "member"
        }
      ],
      "commands": [
        {
          "name": "explore",
          "aliases": [
            "探索视频"
          ],
          "description": "立即浏览一次，有适合当前聊天的发现时再分享",
          "scope": "all",
          "permission": "owner"
        },
        {
          "name": "explorestatus",
          "aliases": [
            "探索状态"
          ],
          "description": "查看上次探索、分享及下次运行时间",
          "scope": "all",
          "permission": "owner"
        },
        {
          "name": "explorelike",
          "aliases": [
            "喜欢这个方向"
          ],
          "description": "记录希望多看的主题：/explorelike 主题",
          "scope": "all",
          "permission": "owner"
        },
        {
          "name": "exploreavoid",
          "aliases": [
            "少看这个方向"
          ],
          "description": "记录希望避开的主题：/exploreavoid 主题",
          "scope": "all",
          "permission": "owner"
        },
        {
          "name": "biliaccounts",
          "description": "验证大号或小号登录：/biliaccounts main 或 browse",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilifolders",
          "description": "列出大号收藏夹",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "biliscan",
          "description": "分页扫描收藏；new 开始新扫描",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "biliplan",
          "description": "分批生成收藏分类方案",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilipreview",
          "description": "分页预览方案：/bilipreview 偏移量",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "biliapply",
          "description": "应用已生成的收藏方案",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilidraft",
          "description": "以小号拟评论：/bilidraft BV号 内容",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilipost",
          "description": "发送指定评论草稿：/bilipost 草稿编号",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "biliinteractions",
          "description": "查看自动评论和回复的处理记录",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilianalyze",
          "description": "分段分析视频：/bilianalyze BV号 [分P序号] [new]",
          "scope": "private",
          "permission": "owner"
        },
        {
          "name": "bilisummary",
          "description": "读取分析总结：/bilisummary BV号 [分P序号] [页码]",
          "scope": "private",
          "permission": "owner"
        }
      ],
      "configSchema": {
        "type": "object",
        "properties": {
          "targetChat": {
            "type": "string",
            "title": "分享会话（留空自动选择）",
            "default": ""
          },
          "interests": {
            "type": "string",
            "title": "感兴趣的话题",
            "default": ""
          },
          "tools": {
            "type": "array",
            "title": "限定探索工具（留空使用实例授权）",
            "default": [],
            "ui": {
              "widget": "tools"
            }
          },
          "intervalMinutes": {
            "type": "integer",
            "title": "探索间隔（分钟）",
            "minimum": 10,
            "maximum": 1440,
            "default": 60
          },
          "minimumScore": {
            "type": "integer",
            "title": "最低推荐评分",
            "minimum": 0,
            "maximum": 100,
            "default": 75
          },
          "accountMode": {
            "type": "string",
            "title": "登录方式",
            "enum": [
              "browser",
              "cookie"
            ],
            "ui": {
              "enumLabels": [
                "浏览器登录",
                "Cookie"
              ]
            },
            "default": "browser"
          },
          "mainUid": {
            "type": "string",
            "title": "大号 UID",
            "default": ""
          },
          "browseUid": {
            "type": "string",
            "title": "小号 UID",
            "default": ""
          },
          "scanFolders": {
            "type": "array",
            "title": "待整理收藏夹 ID",
            "default": []
          },
          "folderRules": {
            "type": "array",
            "title": "收藏分类规则",
            "default": [],
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "folderId": {
                  "type": "string",
                  "title": "收藏夹 ID",
                  "pattern": "^[1-9]\\d{0,29}$",
                  "maxLength": 30
                },
                "description": {
                  "type": "string",
                  "title": "分类说明",
                  "minLength": 1,
                  "maxLength": 600
                }
              },
              "required": [
                "folderId",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "organizeMode": {
            "type": "string",
            "title": "整理方式",
            "enum": [
              "copy",
              "move"
            ],
            "ui": {
              "enumLabels": [
                "复制到目标收藏夹",
                "移动到目标收藏夹"
              ]
            },
            "default": "copy"
          },
          "commentMode": {
            "type": "string",
            "title": "评论功能",
            "enum": [
              "off",
              "draft",
              "auto"
            ],
            "ui": {
              "enumLabels": [
                "关闭",
                "手动发送",
                "自动评论与回复"
              ]
            },
            "default": "off"
          },
          "dailyCommentLimit": {
            "type": "integer",
            "title": "每天最多评论与回复总数",
            "minimum": 0,
            "maximum": 20,
            "default": 3
          },
          "autoOrganize": {
            "type": "boolean",
            "title": "按分类规则自动整理收藏",
            "default": false
          },
          "organizeChat": {
            "type": "string",
            "title": "整理结果接收会话（主人私聊）",
            "default": ""
          },
          "organizeIntervalHours": {
            "type": "integer",
            "title": "收藏扫描间隔（小时）",
            "default": 24,
            "minimum": 1,
            "maximum": 168
          },
          "commentChat": {
            "type": "string",
            "title": "评论管理会话（主人私聊）",
            "default": ""
          },
          "autoComment": {
            "type": "boolean",
            "title": "自动评论新发现的视频",
            "default": false
          },
          "autoReply": {
            "type": "boolean",
            "title": "自动回复小号收到的评论",
            "default": false
          },
          "commentRules": {
            "type": "string",
            "title": "发言要求与禁止事项",
            "default": ""
          },
          "commentIntervalMinutes": {
            "type": "integer",
            "title": "自动发言间隔（分钟）",
            "default": 10,
            "minimum": 1,
            "maximum": 1440
          },
          "threadReplyLimit": {
            "type": "integer",
            "title": "每个话题最多自动回复数",
            "default": 3,
            "minimum": 1,
            "maximum": 10
          },
          "mediaServices": {
            "type": "object",
            "title": "视频阅读与备份",
            "default": {
              "transcribe": {
                "pluginId": "watch",
                "pluginServer": "watch",
                "toolName": "watch_media",
                "arguments": {
                  "kind": "transcribe",
                  "url": "$url",
                  "start": "$start",
                  "end": "$end",
                  "namespace": "$requestScope",
                  "request_id": "$requestId"
                },
                "poll": {
                  "toolName": "watch_media",
                  "arguments": {
                    "kind": "transcribe",
                    "url": "$url",
                    "start": "$start",
                    "end": "$end",
                    "namespace": "$requestScope",
                    "request_id": "$requestId",
                    "job_id": "$jobId"
                  }
                }
              },
              "frames": {
                "pluginId": "watch",
                "pluginServer": "watch",
                "toolName": "watch_media",
                "arguments": {
                  "kind": "frames",
                  "url": "$url",
                  "start": "$start",
                  "end": "$end",
                  "namespace": "$requestScope",
                  "request_id": "$requestId"
                },
                "poll": {
                  "toolName": "watch_media",
                  "arguments": {
                    "kind": "frames",
                    "url": "$url",
                    "start": "$start",
                    "end": "$end",
                    "namespace": "$requestScope",
                    "request_id": "$requestId",
                    "job_id": "$jobId"
                  }
                }
              }
            },
            "scope": "instance",
            "ui": {
              "widget": "media-services",
              "advanced": true
            }
          },
          "backupEnabled": {
            "type": "boolean",
            "title": "自动备份收藏视频到本地",
            "default": false,
            "scope": "instance"
          },
          "backupIntervalHours": {
            "type": "integer",
            "title": "备份扫描间隔（小时）",
            "default": 24,
            "minimum": 1,
            "maximum": 168,
            "scope": "instance"
          },
          "commentSampleLimit": {
            "type": "integer",
            "title": "每个视频最多读取评论数",
            "default": 30,
            "minimum": 0,
            "maximum": 50
          },
          "likeEnabled": {
            "type": "boolean",
            "title": "允许小号点赞",
            "default": false
          },
          "dailyLikeLimit": {
            "type": "integer",
            "title": "每天最多点赞操作数",
            "minimum": 0,
            "maximum": 100,
            "default": 20
          },
          "socialIntervalSeconds": {
            "type": "integer",
            "title": "点赞和私信最短间隔（秒）",
            "minimum": 1,
            "maximum": 3600,
            "default": 60
          },
          "messageMode": {
            "type": "string",
            "title": "站内私信",
            "enum": [
              "off",
              "draft",
              "auto"
            ],
            "ui": {
              "enumLabels": [
                "关闭",
                "手动发送",
                "自动回复"
              ]
            },
            "default": "off"
          },
          "dailyMessageLimit": {
            "type": "integer",
            "title": "每天最多发送私信数",
            "minimum": 0,
            "maximum": 20,
            "default": 3
          },
          "messageAllowedUids": {
            "type": "array",
            "title": "自动回复的私信联系人 UID",
            "default": [],
            "maxItems": 30,
            "items": {
              "type": "string",
              "pattern": "^[1-9]\\d{0,29}$",
              "maxLength": 30
            }
          },
          "messageRules": {
            "type": "string",
            "title": "私信发言要求",
            "default": "",
            "maxLength": 2000
          },
          "autoLike": {
            "type": "boolean",
            "title": "自主点赞",
            "description": "浏览时可按实际收获决定点赞，仍遵守点赞额度。",
            "default": false
          },
          "autoMention": {
            "type": "boolean",
            "title": "回应评论提及",
            "description": "处理开启后收到的评论区 @ 通知。",
            "default": false
          },
          "browseFavoriteFolders": {
            "type": "array",
            "title": "小号可收藏到",
            "description": "填写允许自主收藏的已有小号收藏夹 ID；留空不自动收藏。",
            "items": {
              "type": "string",
              "pattern": "^[1-9]\\d{0,29}$"
            },
            "maxItems": 20,
            "default": []
          },
          "dailyFavoriteLimit": {
            "type": "integer",
            "title": "每天最多收藏",
            "minimum": 0,
            "maximum": 100,
            "default": 5
          },
          "coinEnabled": {
            "type": "boolean",
            "title": "允许投币",
            "default": false
          },
          "dailyCoinLimit": {
            "type": "integer",
            "title": "每天最多投币（枚）",
            "minimum": 0,
            "maximum": 100,
            "default": 5
          },
          "autoCoin": {
            "type": "boolean",
            "title": "自主投币",
            "default": false
          },
          "tripleEnabled": {
            "type": "boolean",
            "title": "允许一键三连",
            "description": "同时点赞、投币并收藏到默认收藏夹；需要开启点赞和投币。",
            "default": false
          }
        }
      },
      "networkHosts": [
        "api.bilibili.com",
        "*.hdslb.com",
        "*.bilibili.com",
        "*.biliimg.com",
        "*.qpic.cn",
        "*.qlogo.cn"
      ],
      "displayName": "B站小管家",
      "tools": [
        {
          "name": "folders",
          "description": "读取大号已有收藏夹。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        {
          "name": "scan",
          "description": "分页扫描指定收藏夹；未完成时继续调用，复用返回的 folderIds。默认只分类。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "folderIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "收藏夹 ID",
                  "maxLength": 160
                },
                "maxItems": 30
              },
              "reset": {
                "type": "boolean"
              },
              "previewOnly": {
                "type": "boolean"
              }
            },
            "required": [
              "folderIds"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "classify",
          "description": "继续为已完成扫描生成分类方案。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "scanId": {
                "type": "string",
                "description": "扫描 ID",
                "maxLength": 160
              }
            },
            "required": [
              "scanId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "preview",
          "description": "分页查看分类方案及待确认项。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "planId": {
                "type": "string",
                "description": "方案 ID",
                "maxLength": 160
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            },
            "required": [
              "planId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "apply",
          "description": "按用户明确要求执行当前方案，使用配置中的复制或移动方式。只分类方案不可执行。每次有限批次，检查返回进度后继续。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "planId": {
                "type": "string",
                "description": "已查看的方案 ID",
                "maxLength": 160
              }
            },
            "required": [
              "planId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "analyze",
          "description": "按字幕、音频、画面顺序分析视频；需要时再次调用继续。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "description": "BV号",
                "maxLength": 160
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "question": {
                "type": "string",
                "maxLength": 1000,
                "description": "需要核实的具体问题；与普通全片分析分别保存进度。"
              },
              "ranges": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "description": "可选时间段，合计不超过900秒。"
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "summary",
          "description": "查看已保存的视频总结。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": false,
          "inputSchema": {
            "type": "object",
            "properties": {
              "bvid": {
                "type": "string",
                "description": "BV号",
                "maxLength": 160
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "question": {
                "type": "string",
                "maxLength": 1000,
                "description": "需要核实的具体问题；与普通全片分析分别保存进度。"
              },
              "ranges": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                },
                "description": "可选时间段，合计不超过900秒。"
              }
            },
            "required": [
              "bvid"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "explore",
          "description": "按兴趣浏览并记笔记，有合适发现时选择分享",
          "export": "agentTool",
          "permission": "owner",
          "scope": "all",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "explore_status",
          "description": "查看最近探索状态",
          "export": "agentTool",
          "permission": "owner",
          "scope": "all",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "remove",
          "description": "移除一个收藏关系，记录编号与理由，可撤销。仅按用户明确要求执行。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "maxLength": 150
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "bvid": {
                "type": "string",
                "maxLength": 160
              },
              "folderId": {
                "type": "string",
                "maxLength": 160
              }
            },
            "required": [
              "operationId",
              "reason",
              "bvid",
              "folderId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "create_folder",
          "description": "新建收藏夹，默认私密。记录可撤销；同一操作沿用 operationId。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "maxLength": 150
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "title": {
                "type": "string",
                "maxLength": 80
              },
              "intro": {
                "type": "string",
                "maxLength": 500
              },
              "private": {
                "type": "boolean"
              }
            },
            "required": [
              "operationId",
              "reason",
              "title"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "delete_folder",
          "description": "先分页保存完整清单，再删除收藏夹。preparing/backing_up 时继续同一 operationId。撤销会重建为新编号。",
          "export": "agentTool",
          "permission": "owner",
          "scope": "private",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "operationId": {
                "type": "string",
                "maxLength": 150
              },
              "reason": {
                "type": "string",
                "maxLength": 1000
              },
              "folderId": {
                "type": "string",
                "maxLength": 160
              }
            },
            "required": [
              "operationId",
              "reason",
              "folderId"
            ],
            "additionalProperties": false
