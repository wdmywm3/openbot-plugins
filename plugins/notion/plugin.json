{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notion",
  "version": "1.0.0",
  "description": "使用 Notion 官方 MCP 搜索和处理账号有权访问的工作区内容。",
  "extensions": {
    "com.openbot": {
      "displayName": "Notion",
      "category": "integration",
      "permissions": ["mcp"],
      "metadata": {
        "usage": "在插件详情中打开 Notion 服务，点击网页登录，选择要连接的工作区。",
        "homepage": "https://developers.notion.com/guides/mcp/get-started-with-mcp"
      },
      "oauthMcpServers": ["Notion"]
    }
  }
}
