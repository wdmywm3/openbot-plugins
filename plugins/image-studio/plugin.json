{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "image-studio",
  "version": "0.6.1",
  "description": "生成图片或动图，可用多张参考图改图，也可让角色模仿参考图中的表情和动作。",
  "extensions": {
    "com.openbot": {
      "displayName": "画图",
      "category": "utility",
      "icon": "image",
      "apiVersion": 1,
      "main": "index.js",
      "execution": { "concurrency": "parallel" },
      "permissions": [
        "network",
        "network:stream",
        "secret",
        "history",
        "assets",
        "profiles:media",
        "state",
        "state:global",
        "model:request",
        "model:select",
        "conversation",
        "conversation:notify"
      ],
      "requiredFeatures": [
        "livePluginConfig",
        "nativeModelRequests",
        "modelResponseSelection",
        "connectedModelCatalog",
        "pluginGlobalSettings",
        "pluginSettingsGroups",
        "globalPluginDatabase",
        "pluginAdmissionQueue",
        "conditionalGlobalSettings",
        "mediaHandoff",
        "mediaRepublication",
        "toolCompletionEvents",
        "pluginSkillUpload",
        "pluginSettingScopes"
      ],
      "networkHosts": [
        "*"
      ],
      "config": {
        "imageEnabled": true,
        "selfieEnabled": false,
        "allowNonOwnerDrawing": false,
        "provider": "openai-images",
        "openaiImageModel": "",
        "openaiTextModel": "",
        "compatibleBaseUrl": "",
        "compatibleImageModel": "",
        "compatibleTextModel": "",
        "compatibleJsonEdits": false,
        "compatibleStream": true,
        "codexModelId": "",
        "codexImageModel": "",
        "codexResponseModel": "",
        "size": "1024x1024",
        "quality": "medium",
        "globalConcurrency": 4,
        "instanceConcurrencyDefault": 2,
        "instanceConcurrency": 0,
        "queueLimit": 32,
        "queueTimeoutSeconds": 420,
        "instanceHourlyDefault": 20,
        "instanceDailyDefault": 100,
        "instanceHourly": 0,
        "instanceDaily": 0,
        "globalHourly": 40,
        "globalDaily": 200
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "customService": {
            "type": "boolean",
            "title": "画图服务",
            "scope": "instance",
            "default": false
          },
          "customOutput": {
            "type": "boolean",
            "title": "输出设置",
            "scope": "instance",
            "default": false
          },
          "imageEnabled": {
            "type": "boolean",
            "title": "普通生图",
            "default": true,
            "scope": "instance"
          },
          "selfieEnabled": {
            "type": "boolean",
            "title": "自拍",
            "default": false,
            "scope": "instance"
          },
          "allowNonOwnerDrawing": {
            "type": "boolean",
            "title": "允许非主人画图",
            "default": false,
            "scope": "instance"
          },
          "provider": {
            "type": "string",
            "title": "接入方式",
            "enum": [
              "auto",
              "openai-images",
              "openai-responses",
              "compatible-images",
              "compatible-responses",
              "codex"
            ],
            "ui": {
              "enumLabels": [
                "自动选择",
                "OpenAI 图片",
                "OpenAI 对话绘图",
                "兼容图片服务",
                "兼容对话绘图",
                "Codex 登录"
              ]
            },
            "default": "openai-images",
            "scope": "global"
          },
          "openaiImageModel": {
            "type": "string",
            "title": "OpenAI 画图模型",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "openaiTextModel": {
            "type": "string",
            "title": "OpenAI 对话模型",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "compatibleBaseUrl": {
            "type": "string",
            "title": "兼容服务地址",
            "description": "填写带版本路径的 HTTPS 根地址。",
            "default": "",
            "maxLength": 2000,
            "scope": "global"
          },
          "compatibleImageModel": {
            "type": "string",
            "title": "兼容服务画图模型",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "compatibleTextModel": {
            "type": "string",
            "title": "兼容服务对话模型",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "compatibleJsonEdits": {
            "type": "boolean",
            "title": "兼容图片服务支持 JSON 参考图",
            "default": false,
            "scope": "global"
          },
          "compatibleStream": {
            "type": "boolean",
            "title": "兼容图片服务使用流式返回",
            "default": true,
            "scope": "global"
          },
          "codexModelId": {
            "type": "string",
            "title": "登录模型",
            "description": "留空自动选用已登录的模型。",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "codexImageModel": {
            "type": "string",
            "title": "Codex 画图模型",
            "description": "留空时图片使用服务默认值，GIF 使用 GPT Image 2.6 Flare。",
            "default": "",
            "maxLength": 200,
            "scope": "global"
          },
          "codexResponseModel": {
            "type": "string",
            "title": "绘图执行模型",
            "description": "留空沿用所选登录模型。",
            "default": "",
            "maxLength": 128,
            "scope": "global"
          },
          "size": {
            "type": "string",
            "title": "默认尺寸",
            "enum": [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            "ui": {
              "enumLabels": [
                "自动",
                "方形",
                "横图",
                "竖图"
              ]
            },
            "default": "1024x1024",
            "scope": "global",
            "chatOverride": true
          },
          "quality": {
            "type": "string",
            "title": "默认画质",
            "enum": [
              "auto",
              "low",
              "medium",
              "high"
            ],
            "ui": {
              "enumLabels": [
                "自动",
                "低",
                "中",
                "高"
              ]
            },
            "default": "medium",
            "scope": "global",
            "chatOverride": true
          },
          "globalConcurrency": {
            "type": "integer",
            "title": "总并发数",
            "default": 4,
            "minimum": 1,
            "maximum": 32,
            "scope": "global"
          },
          "instanceConcurrencyDefault": {
            "type": "integer",
            "title": "每个实例默认并发数",
            "default": 2,
            "minimum": 1,
            "maximum": 32,
            "scope": "global"
          },
          "instanceConcurrency": {
            "type": "integer",
            "title": "并发数",
            "description": "0 使用插件默认值。",
            "default": 0,
            "minimum": 0,
            "maximum": 32,
            "scope": "instance"
          },
          "queueLimit": {
            "type": "integer",
            "title": "最多排队任务",
            "default": 32,
            "minimum": 0,
            "maximum": 100,
            "scope": "global"
          },
          "queueTimeoutSeconds": {
            "type": "integer",
            "title": "最长排队时间（秒）",
            "default": 420,
            "minimum": 1,
            "maximum": 3600,
            "scope": "global"
          },
          "instanceHourlyDefault": {
            "type": "integer",
            "title": "每实例默认每小时上限",
            "default": 20,
            "minimum": 1,
            "maximum": 100000,
            "scope": "global"
          },
          "instanceDailyDefault": {
            "type": "integer",
            "title": "每实例默认每日上限",
            "default": 100,
            "minimum": 1,
            "maximum": 100000,
            "scope": "global"
          },
          "instanceHourly": {
            "type": "integer",
            "title": "每小时上限",
            "description": "0 使用插件默认值。",
            "default": 0,
            "minimum": 0,
            "maximum": 100000,
            "scope": "instance"
          },
          "instanceDaily": {
            "type": "integer",
            "title": "每日上限",
            "description": "0 使用插件默认值。",
            "default": 0,
            "minimum": 0,
            "maximum": 100000,
            "scope": "instance"
          },
          "globalHourly": {
            "type": "integer",
            "title": "总每小时上限",
            "default": 40,
            "minimum": 1,
            "maximum": 100000,
            "scope": "global"
          },
          "globalDaily": {
            "type": "integer",
            "title": "总每日上限",
            "default": 200,
            "minimum": 1,
            "maximum": 100000,
            "scope": "global"
          }
        },
        "additionalProperties": false
      },
      "tools": [
        {
          "name": "draw_image",
          "export": "draw_image",
          "title": "画图",
          "completion": "chat",
          "successLabel": "生成成功",
          "description": "生成一张图片或 GIF 动图。拟写提示词前按当前可用的 image-studio:imagegen 指南构图。普通生图和改图使用 mode=image。画自己的角色形象使用 mode=selfie，自动选取角色形象图，可另传聊天参考图或指定视角。两种方式分别启用。返回可发送的图片地址。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "admission": {
            "global": "globalConcurrency",
            "instance": "instanceConcurrency",
            "instanceDefault": "instanceConcurrencyDefault",
            "queue": "queueLimit",
            "timeoutSeconds": "queueTimeoutSeconds"
          },
          "inputSchema": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "image",
                  "selfie"
                ],
                "description": "默认为 image。画自己的形象时使用 selfie，由插件选取当前角色人设图或实例备用图。"
              },
              "selfieView": {
                "type": "string",
                "enum": [
                  "front",
                  "side",
                  "back",
                  "chibi",
                  "detail",
                  "other"
                ],
                "description": "仅适用于自拍。明确要求侧面、背面、Q 版或细节时选择对应视角，留空优先正面。"
              },
              "prompt": {
                "type": "string",
                "description": "直接送入图像 API 的自然语言正文。从画面或具体编辑指令起笔，写清可见主体、构图与必要细节。任务名放在外层 title，请求者和聊天经过留在会话中。画面需要印出的原文用引号标明。",
                "minLength": 1,
                "maxLength": 12000
              },
              "provider": {
                "type": "string",
                "enum": [
                  "openai-images",
                  "openai-responses",
                  "compatible-images",
                  "compatible-responses",
                  "codex"
                ],
                "description": "仅在用户明确选择服务时填写，否则沿用设置。"
              },
              "size": {
                "type": "string",
                "enum": [
                  "auto",
                  "1024x1024",
                  "1536x1024",
                  "1024x1536"
                ]
              },
              "quality": {
                "type": "string",
                "enum": [
                  "auto",
                  "low",
                  "medium",
                  "high"
                ]
              },
              "background": {
                "type": "string",
                "enum": [
                  "auto",
                  "opaque",
                  "transparent"
                ]
              },
              "format": {
                "type": "string",
                "enum": [
                  "png",
                  "webp",
                  "jpeg",
                  "gif"
                ]
              },
              "frameCount": {
                "type": "integer",
                "minimum": 2,
                "maximum": 16,
                "description": "仅 GIF 动图使用；留空使用服务默认值。"
              },
              "frameDurationMs": {
                "type": "integer",
                "minimum": 20,
                "maximum": 2000,
                "description": "仅 GIF 动图使用，每帧时长，单位毫秒。"
              },
              "referenceOrder": {
                "type": "array",
                "maxItems": 10,
                "description": "可选，指定参考图的发送顺序。ref1 至 ref4 是 references 中的原图或首帧，frames1 至 frames4 是对应动图的动作拼图，role1、role2 是本次自拍提供的角色视图。只列需要优先排列的项，其余自动跟随。",
                "items": { "type": "string", "enum": ["ref1", "ref2", "ref3", "ref4", "frames1", "frames2", "frames3", "frames4", "role1", "role2"] }
              },
              "references": {
                "type": "array",
                "maxItems": 4,
                "description": "普通生图、改图和自拍均可传入最多四张图，静态和 GIF 均适用。按最终发送顺序在提示词里称图1、图2等，并写清各图用途。自拍的角色形象图由插件另外附上。",
                "items": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    "assetRef": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000,
                      "description": "当前聊天中任意插件返回的完整图片 URL。与 messageId、assetRef 三选一。"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "purpose": {
                "type": "string",
                "enum": [
                  "image",
                  "sticker"
                ],
                "description": "默认 image。只有当前请求或相关前文明确定义为聊天表情，或用于点头、收到、委屈等聊天反应时才选 sticker，静态和动图均可。仅要求画图、动图、角色自拍或可爱动作，不足以判定为表情；用途不明确时保持 image，不为是否收藏追问。表情成品发出后按收藏设置收录。"
              },
              "draft": {
                "type": "boolean",
                "description": "改稿中间版或试验版本设为 true，不自动收藏。默认 false 表示本次交付的成品。"
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "recover_image",
          "export": "recover_image",
          "title": "取回已画的图片",
          "description": "补发本聊天已生成的画图结果时，传入原任务或会话中记录的完整图片地址，取得当前可发送的地址。复用原图，不消耗生图额度。",
          "scope": "all",
          "permission": "member",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "minLength": 1, "maxLength": 128, "description": "原画图结果中的 images[].url。" }
            },
            "required": ["url"],
            "additionalProperties": false
          }
        }
      ],
      "actions": [
        {
          "id": "model_catalog",
          "title": "获取模型",
          "kind": "native",
          "export": "model_catalog",
          "readOnly": true,
          "global": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "openai",
                  "compatible",
                  "codex",
                  "codex-connections"
                ]
              },
              "target": {
                "type": "string",
                "enum": [
                  "image",
                  "response"
                ]
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "readiness",
          "title": "检查画图服务",
          "kind": "native",
          "export": "readiness",
          "readOnly": true,
          "global": true,
          "inputSchema": {
            "type": "object",
            "properties": {},
            "additionalProperties": false
          }
        },
        {
          "id": "selfie_reference",
          "title": "自拍形象",
          "kind": "native",
          "export": "selfie_reference",
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "get",
                  "set",
                  "clear"
                ]
              },
              "assetRef": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        }
      ],
      "ui": {
        "version": 1,
        "settingsCheck": "readiness",
        "sections": [
          {
            "id": "settings",
            "title": "设置",
            "fields": [
              "imageEnabled",
              "selfieEnabled",
              "allowNonOwnerDrawing",
              "customService",
              "customOutput"
            ]
          },
          {
            "id": "limits",
            "title": "用量",
            "fields": [
              "instanceConcurrency",
              "instanceHourly",
              "instanceDaily"
            ]
          }
        ],
        "globalSections": [
          {
            "id": "service",
            "title": "画图服务",
            "fields": [
              "provider"
            ]
          },
          {
            "id": "output",
            "title": "输出设置",
            "fields": [
              "size",
              "quality"
            ]
          },
          {
            "id": "skill",
            "title": "生图 Skill",
            "fields": [],
            "widgets": [
              {
                "type": "skill-upload",
                "title": "生图 Skill",
                "skills": [
                  "imagegen",
                  "gpt-image"
                ]
              }
            ]
          },
          {
            "id": "openai",
            "title": "OpenAI",
            "fields": [],
            "widgets": [
              {
                "type": "secret",
                "key": "openaiKey",
                "title": "OpenAI API Key"
              },
              {
                "type": "remote-options",
                "field": "openaiImageModel",
                "title": "画图模型",
                "action": "model_catalog",
                "input": {
                  "source": "openai",
                  "target": "image"
                }
              },
              {
                "type": "remote-options",
                "field": "openaiTextModel",
                "title": "对话模型",
                "action": "model_catalog",
                "input": {
                  "source": "openai",
                  "target": "response"
                },
                "when": {
                  "field": "provider",
                  "equals": "openai-responses"
                }
              }
            ],
            "when": {
              "field": "provider",
              "oneOf": [
                "openai-images",
                "openai-responses"
              ]
            }
          },
          {
            "id": "compatible",
            "title": "兼容服务",
            "fields": [
              "compatibleBaseUrl",
              "compatibleJsonEdits",
              "compatibleStream"
            ],
            "widgets": [
              {
                "type": "secret",
                "key": "compatibleKey",
                "title": "兼容服务 API Key"
              },
              {
                "type": "remote-options",
                "field": "compatibleImageModel",
                "title": "画图模型",
                "action": "model_catalog",
                "input": {
                  "source": "compatible",
                  "target": "image"
                },
                "dependsOn": [
                  "compatibleBaseUrl"
                ]
              },
              {
                "type": "remote-options",
                "field": "compatibleTextModel",
                "title": "对话模型",
                "action": "model_catalog",
                "input": {
                  "source": "compatible",
                  "target": "response"
                },
                "dependsOn": [
                  "compatibleBaseUrl"
                ],
                "when": {
                  "field": "provider",
                  "equals": "compatible-responses"
                }
              }
            ],
            "when": {
              "field": "provider",
              "oneOf": [
                "compatible-images",
                "compatible-responses"
              ]
            }
          },
          {
            "id": "codex",
            "title": "Codex 登录",
            "fields": [],
            "widgets": [
              {
                "type": "remote-options",
                "field": "codexModelId",
                "title": "登录模型",
                "action": "model_catalog",
                "input": {
                  "source": "codex-connections"
                }
              },
              {
                "type": "remote-options",
                "field": "codexImageModel",
                "title": "画图模型",
                "description": "登录服务可能不提供画图模型列表；实际模型由服务决定。",
                "action": "model_catalog",
                "input": {
                  "source": "codex",
                  "target": "image"
                },
                "dependsOn": [
                  "codexModelId"
                ]
              },
              {
                "type": "remote-options",
                "field": "codexResponseModel",
                "title": "绘图执行模型",
                "action": "model_catalog",
                "input": {
                  "source": "codex",
                  "target": "response"
                },
                "dependsOn": [
                  "codexModelId"
                ]
              }
            ],
            "when": {
              "field": "provider",
              "oneOf": [
                "codex"
              ]
            }
          },
          {
            "id": "limits",
            "title": "用量",
            "fields": [
              "globalConcurrency",
              "instanceConcurrencyDefault",
              "queueLimit",
              "queueTimeoutSeconds",
              "instanceHourlyDefault",
              "instanceDailyDefault",
              "globalHourly",
              "globalDaily"
            ]
          }
        ],
        "views": [
          {
            "id": "selfie-reference",
            "title": "自拍形象",
            "entry": "ui/reference.html",
            "actions": [
              "selfie_reference"
            ]
          }
        ],
        "settingsGroups": [
          {
            "mode": "customService",
            "sections": [
              "service",
              "openai",
              "compatible",
              "codex"
            ],
            "summary": "provider"
          },
          {
            "mode": "customOutput",
            "sections": [
              "output"
            ],
            "summary": "size"
          }
        ],
        "chatAudiences": [
          "group:member",
          "group:owner",
          "private:member",
          "private:owner"
        ]
      },
      "metadata": {
        "platforms": [
          "napcat",
          "qqbot"
        ],
        "usage": "描述想画的图片或提出改图要求。单独开启自拍后，会优先使用当前角色的人设图。",
        "requirements": [
          "请先将 OpenBot 更新至支持补发旧图的版本，再更新本插件。",
          "使用 Codex 绘图前，请先在模型设置中完成登录。"
        ],
        "changelog": "0.6.0 支持按实例自定义画图服务和输出设置，或跟随插件默认配置。需要 OpenBot 0.1.120 或更高版本。"
      }
    }
  }
}
