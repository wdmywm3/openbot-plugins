{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "tool-workshop",
  "version": "0.1.0",
  "description": "让 Bot 编写、试运行并保存可重复调用的 JavaScript 工具。",
  "extensions": {
    "com.openbot": {
      "displayName": "工具工坊",
      "category": "utility",
      "icon": "wrench",
      "apiVersion": 1,
      "requiredFeatures": [
        "scriptExecution"
      ],
      "main": "index.js",
      "permissions": [
        "state",
        "script:run",
        "network",
        "model:request",
        "model:select",
        "assets",
        "hook:context"
      ],
      "networkHosts": [
        "*"
      ],
      "config": {
        "allowNetwork": false,
        "allowModelRequests": false,
        "allowMedia": false
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "allowNetwork": {
            "type": "boolean",
            "title": "允许工具联网",
            "default": false
          },
          "allowModelRequests": {
            "type": "boolean",
            "title": "允许工具调用模型",
            "default": false
          },
          "allowMedia": {
            "type": "boolean",
            "title": "允许工具保存媒体",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "ui": {
        "version": 1,
        "sections": [
          {
            "id": "settings",
            "title": "设置",
            "fields": [
              "allowNetwork",
              "allowModelRequests",
              "allowMedia"
            ],
            "widgets": []
          }
        ]
      },
      "tools": [
        {
          "name": "manage",
          "export": "manage",
          "description": "编写、检查、试运行和保存当前私聊的工具。先 read/list，再按当前 revision 更新；保存要求当前草稿已经通过试运行。",
          "scope": "private",
          "permission": "owner",
          "cancellation": "cooperative",
          "timeoutMs": 200000,
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "list",
                  "read",
                  "draft",
                  "test",
                  "save",
                  "remove"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48000
              },
              "inputSchema": {
                "type": "object",
                "additionalProperties": true
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "request",
                    "modelRequest",
                    "assets"
                  ]
                },
                "maxItems": 3
              },
              "input": {
                "type": "object",
                "additionalProperties": true
              },
              "expectedJson": {
                "type": "string",
                "maxLength": 60000
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 180000
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "run",
          "export": "run",
          "description": "执行当前私聊已保存的工具。先通过 manage list/read 取得工具 ID、revision 和参数说明；新草稿不影响已保存版本。",
          "scope": "private",
          "permission": "owner",
          "cancellation": "cooperative",
          "timeoutMs": 200000,
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "input": {
                "type": "object",
                "additionalProperties": true
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 180000
              }
            },
            "required": [
              "id",
              "revision",
              "input"
            ],
            "additionalProperties": false
          }
        }
      ],
      "hooks": [
        {
          "type": "context",
          "export": "context",
          "scope": "private",
          "permission": "owner",
          "tools": [
            "useSkill"
          ]
        }
      ],
      "metadata": {
        "platforms": [
          "napcat",
          "qqbot"
        ],
        "requirements": [
          "请先安装 OpenBot 0.1.99 或更新版本，再更新本插件。需支持 scriptExecution 及所选的显式能力。"
        ],
        "changelog": "0.1.0：工具草稿、试运行、版本保存与复用；可显式授权联网、模型和媒体能力，自写绘图工具。"
      }
    }
  }
}
