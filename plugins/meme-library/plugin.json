{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "meme-library",
  "version": "2.5.3",
  "description": "管理聊天表情，自动识图，通过共享检索模型按语境选图。",
  "extensions": {
    "com.openbot": {
      "displayName": "表情包",
      "category": "entertainment",
      "apiVersion": 1,
      "requiredFeatures": [
        "persistentContextItems",
        "instanceSettingsViews",
        "pluginNavigationV2",
        "pluginOverlays",
        "modelHookTextInput",
        "resumableJobSlices",
        "pagedProfileMedia",
        "profileMediaMetadata",
        "qqGateway"
      ],
      "main": "index.js",
      "permissions": [
        "reply",
        "state",
        "assets",
        "jobs",
        "history",
        "model",
        "model:select",
        "retrieval",
        "mcp",
        "network",
        "qq:fetch_custom_face",
        "hook:loaded",
        "hook:beforeModel",
        "hook:beforeSend",
        "hook:afterSend",
        "hook:messageReceived",
        "prompt:system",
        "hook:beforeDispatch",
        "profiles:media",
        "hook:profileChanged",
        "hook:afterModel"
      ],
      "dependencies": {
        "node": {
          "lockfile": "package-lock.json"
        }
      },
      "commands": [
        {
          "name": "meme",
          "aliases": [
            "表情",
            "表情包"
          ],
          "description": "按关键词或随机发送表情",
          "scope": "all",
          "permission": "member"
        },
        {
          "name": "memeinfo",
          "aliases": [
            "表情库"
          ],
          "description": "查看可用表情数量",
          "scope": "all",
          "permission": "member"
        }
      ],
      "tools": [
        {
          "name": "stickers",
          "export": "stickers",
          "aliases": [
            "qqSticker"
          ],
          "description": "按想表达的意思或图片原话检索表情，给可填字表情填写短句，或收藏当前聊天图片。",
          "scope": "all",
          "permission": "member",
          "mutating": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "search",
                  "render",
                  "collect",
                  "add",
                  "no_match",
                  "feedback"
                ]
              },
              "query": {
                "type": "string",
                "maxLength": 1000,
                "description": "这次想表达的意思或要找的图片原话。"
              },
              "mode": {
                "type": "string",
                "description": "auto 按意思和文字匹配。text 优先匹配图上的原话。",
                "enum": [
                  "auto",
                  "text"
                ]
              },
              "kind": {
                "type": "string",
                "description": "检索时可选。template 只找可填字表情，ordinary 只找普通表情，any 搜索两种。",
                "enum": [
                  "any",
                  "ordinary",
                  "template"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "messageId": {
                "type": "string",
                "maxLength": 200
              },
              "imageIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "searchId": {
                "type": "string",
                "maxLength": 256
              },
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "text": {
                "type": "string",
                "maxLength": 160
              },
              "feedback": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "wrong",
                  "replaced",
                  "no_match"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "required": [
              "action"
            ]
          }
        }
      ],
      "hooks": [
        {
          "type": "beforeDispatch",
          "export": "beforeSend"
        },
        {
          "type": "loaded",
          "export": "loaded"
        },
        {
          "type": "beforeModel",
          "export": "beforeModel",
          "inputMode": "text",
          "concurrency": "parallel"
        },
        {
          "type": "beforeSend",
          "export": "beforeSend"
        },
        {
          "type": "afterSend",
          "export": "afterSend"
        },
        {
          "type": "messageReceived",
          "export": "messageReceived"
        },
        {
          "type": "profileChanged",
          "export": "profileChanged"
        },
        {
          "type": "afterModel",
          "export": "afterModel"
        }
      ],
      "actions": [
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 200
              },
              "status": {
                "type": "string",
                "maxLength": 200
              },
              "profileId": {
                "type": "string",
                "maxLength": 200
              },
              "chatId": {
                "type": "string",
                "maxLength": 200
              },
              "settingsChatId": {
                "type": "string",
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "maxLength": 200
              },
              "analysis": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "id": "list",
          "export": "list",
          "readOnly": true
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "chatMode": {
                "type": "string",
                "enum": [
                  "all",
                  "include",
                  "exclude"
                ]
              },
              "chatIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "profileIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "roleProfileId": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "id": "import",
          "export": "importFiles"
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              },
              "enabled": {
                "type": "boolean"
              },
              "chatMode": {
                "type": "string",
                "enum": [
                  "all",
                  "include",
                  "exclude"
                ]
              },
              "caption": {
                "type": "string",
                "maxLength": 3000
              },
              "meaning": {
                "type": "string",
                "maxLength": 3000
              },
              "literalDescription": {
                "type": "string",
                "maxLength": 3000
              },
              "ocrText": {
                "type": "string",
                "maxLength": 3000
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "emotions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "useCases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "communicativeIntent": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "tone": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "targetRole": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "usageExamples": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "avoidContexts": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "style": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "profileIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "chatIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "roleProfileId": {
                "type": "string",
                "maxLength": 200
              },
              "clearTextTemplate": {
                "type": "boolean"
              },
              "textTemplate": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "revision"
            ]
          },
          "id": "save",
          "export": "save"
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "id": "remove",
          "export": "remove"
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "id": "update",
          "export": "update"
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "id": "job",
          "export": "job"
        },
        {
          "kind": "native",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "inherit": {
                "type": "boolean"
              }
            }
          },
          "id": "settings",
          "export": "saveSettings"
        },
        {
          "kind": "job",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "id": "process",
          "export": "process",
          "permission": "member",
          "restartable": true,
          "timeoutMs": 3600000
        },
        {
          "kind": "job",
          "inputSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "id": "sync",
          "export": "sync",
          "permission": "owner",
          "restartable": true,
          "timeoutMs": 3600000
        },
        {
          "id": "detail",
          "kind": "native",
          "export": "detail",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "id": "importBundle",
          "kind": "job",
          "export": "importBundle",
          "restartable": true,
          "timeoutMs": 3600000,
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "properties": {
              "refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 32
              }
            },
            "required": [
              "refs"
            ]
          }
        },
        {
          "id": "syncProfiles",
          "kind": "job",
          "export": "syncProfiles",
          "restartable": true,
          "timeoutMs": 3600000,
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "id": "exportBundle",
          "kind": "job",
          "export": "exportBundle",
          "restartable": false,
          "timeoutMs": 3600000,
          "permission": "owner",
          "inputSchema": {
            "type": "object",
            "properties": {
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 500
              }
            }
          }
        },
        {
          "id": "stop",
          "kind": "native",
          "export": "stop",
          "inputSchema": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "id": "history",
          "kind": "native",
          "export": "history",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 256
              },
              "key": {
                "type": "string",
                "maxLength": 256
              },
              "cursor": {
                "type": "string"
              }
            }
          }
        },
        {
          "id": "selection",
          "kind": "native",
          "export": "selection",
          "readOnly": true,
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 200
              },
              "status": {
                "type": "string",
                "maxLength": 200
              },
              "profileId": {
                "type": "string",
                "maxLength": 200
              },
              "chatId": {
                "type": "string",
                "maxLength": 200
              },
              "settingsChatId": {
                "type": "string",
                "maxLength": 200
              },
              "source": {
                "type": "string",
                "maxLength": 200
              },
              "analysis": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        },
        {
          "id": "batch",
          "kind": "native",
          "export": "batch",
          "inputSchema": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string",
                "enum": [
                  "enable",
                  "disable",
                  "scope",
                  "remove"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                }
              },
              "chatMode": {
                "type": "string",
                "enum": [
                  "all",
                  "include",
                  "exclude"
                ]
              },
              "chatIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 1000
              },
              "profileIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "roleProfileId": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "operation",
              "items"
            ],
            "additionalProperties": false
          }
        }
      ],
      "ui": {
        "version": 2,
        "layout": "settings",
        "sections": [],
        "views": [
          {
            "id": "library",
            "title": "表情包",
            "entry": "ui/index.html",
            "actions": [
              "list",
              "import",
              "save",
              "remove",
              "update",
              "job",
              "settings",
              "sync",
              "detail",
              "importBundle",
              "exportBundle",
              "stop",
              "history",
              "selection",
              "batch"
            ]
          },
          {
            "id": "editor",
            "title": "编辑表情",
            "entry": "ui/panel.html",
            "actions": [
              "list",
              "detail",
              "save",
              "remove",
              "history",
              "update"
            ],
            "presentation": "dialog"
          },
          {
            "id": "preferences",
            "title": "表情设置",
            "entry": "ui/panel.html",
            "actions": [
              "list",
              "settings"
            ],
            "presentation": "dialog"
          },
          {
            "id": "history",
            "title": "使用记录",
            "entry": "ui/panel.html",
            "actions": [
              "history"
            ],
            "presentation": "dialog"
          },
          {
            "id": "scope",
            "title": "设置适用范围",
            "entry": "ui/panel.html",
            "actions": [
              "list",
              "batch",
              "import"
            ],
            "presentation": "dialog"
          }
        ],
        "contributions": [
          {
            "id": "library",
            "kind": "page",
            "mode": "add",
            "target": "instance.sidebar",
            "parent": "memory",
            "label": "表情包",
            "icon": "image",
            "order": 20,
            "viewId": "library"
          }
        ]
      },
      "metadata": {
        "changelog": "根据当前实例的 QQ 网关能力提供收藏同步。",
        "requirements": [
          "请先安装 OpenBot 0.1.99 或更新版本，再更新本插件。需支持分页角色媒体、插件弹窗及持久上下文。",
          "OpenBot 的受管 Node.js 24 环境；Windows x64 已验证，CPU 推理，无需 Python 或 CUDA。",
          "需要宿主提供 embeddings 和 vectorIndex 接口；图片准备服务仅安装 sharp，不再安装 Transformers 或 ONNX Runtime。",
          "检索模型和下载来源统一在 OpenBot 的模型设置中管理；不可用时使用插件的 BM25 关键词索引。"
        ]
      },
      "networkHosts": [
        "qpic.cn",
        "*.qpic.cn",
        "multimedia.nt.qq.com.cn",
        "*.qq.com.cn",
        "huggingface.co",
        "hf-mirror.com",
        "*.hf.co",
        "*.huggingface.co"
      ],
      "background": {
        "export": "recover",
        "intervalSeconds": 900,
        "startupDelaySeconds": 30,
        "jitterSeconds": 30
      },
      "execution": {
        "concurrency": "parallel"
      }
    }
  }
}
