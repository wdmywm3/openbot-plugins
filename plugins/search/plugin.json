{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "search",
  "version": "0.3.2",
  "description": "搜索并核对网页资料、按描述找参考图，或用聊天图片查出处。",
  "extensions": {
    "com.openbot": {
      "displayName": "搜索",
      "category": "utility",
      "icon": "search",
      "apiVersion": 1,
      "main": "index.js",
      "execution": { "concurrency": "parallel" },
      "permissions": [
        "network",
        "secret",
        "history",
        "settings:import",
        "model:request",
        "assets",
        "network:stream"
      ],
      "networkHosts": [
        "*"
      ],
      "legacySettings": "websearch",
      "config": {
        "webProvider": "anysearch",
        "imageProvider": "off"
      },
      "configSchema": {
        "type": "object",
        "properties": {
          "webProvider": {
            "type": "string",
            "title": "网页搜索",
            "enum": [
              "anysearch",
              "tavily",
              "exa",
              "brave",
              "openai"
            ],
            "default": "anysearch",
            "ui": {
              "enumLabels": [
                "AnySearch",
                "Tavily",
                "Exa",
                "Brave Search",
                "OpenAI 原生搜索"
              ]
            },
            "scope": "global"
          },
          "imageProvider": {
            "type": "string",
            "title": "以图搜图",
            "enum": [
              "off",
              "google"
            ],
            "default": "off",
            "ui": {
              "enumLabels": [
                "未启用",
                "Google Cloud Vision"
              ]
            },
            "scope": "global"
          },
          "customWeb": {
            "type": "boolean",
            "title": "网页搜索",
            "scope": "instance",
            "default": false
          },
          "customImage": {
            "type": "boolean",
            "title": "以图搜图",
            "scope": "instance",
            "default": false
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "tools": [
        {
          "name": "web_search",
          "export": "web_search",
          "description": "搜索网页资料。completed 后读取 result：资料足够就用结论和来源答复，只有线索就用 read_webpage 核对原文。找图可传 resultType=images，要给对方看图时用 prepare_reference 取图。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1
              },
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "search_depth": {
                "type": "string",
                "enum": [
                  "basic",
                  "advanced"
                ]
              },
              "include_domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253
                },
                "maxItems": 20
              },
              "exclude_domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 253
                },
                "maxItems": 20
              },
              "domain": {
                "type": "string",
                "maxLength": 80
              },
              "sub_domain": {
                "type": "string",
                "maxLength": 160
              },
              "sub_domain_params": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "resultType": {
                "type": "string",
                "enum": [
                  "text",
                  "images"
                ]
              }
            },
            "required": [
              "query"
            ],
            "additionalProperties": false
          },
          "aliases": [
            "web_search",
            "search_web",
            "mcp__anysearch__search"
          ],
          "mutating": false
        },
        {
          "name": "read_webpage",
          "export": "read_webpage",
          "description": "读取已知网址的正文。用读到的内容回答并附来源。需要截图时传 includeImages=true，从返回的候选图中选择 imageUrl 和 sourceUrl 交给 prepare_reference。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 3000
              },
              "maxChars": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 50000
              },
              "includeImages": {
                "type": "boolean",
                "description": "读取页面中的候选图片、原图链接及作品详情入口。"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          },
          "aliases": [
            "web_fetch",
            "mcp__anysearch__extract"
          ],
          "mutating": false
        },
        {
          "name": "prepare_reference",
          "export": "prepare_reference",
          "description": "下载候选图片供核对。查看预览后，要给对方看图，就把 result.reference.url 放进 qqReply 的 <image src=\"…\"/>。要用作画图参考，就把 result.reference 交给画图工具。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "imageUrl": {
                "type": "string",
                "maxLength": 3000
              },
              "sourceUrl": {
                "type": "string",
                "maxLength": 3000
              }
            },
            "required": [
              "imageUrl",
              "sourceUrl"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "search_by_image",
          "export": "search_by_image",
          "description": "用当前聊天的图片查出处、角色、作品或物品。messageId 取自真实消息，index 从 0 开始。根据完整匹配、相似图和来源页回答，仅有相似图时说明出处待确认。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "messageId": {
                "type": "string",
                "maxLength": 300
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              "max_results": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "messageId"
            ],
            "additionalProperties": false
          },
          "when": {
            "field": "imageProvider",
            "equals": "google"
          },
          "mutating": false
        },
        {
          "name": "batch_search",
          "export": "batch_search",
          "description": "批量查询 2–5 个独立问题，可使用已查明的 AnySearch 领域参数。完成后逐项看结果，用有依据的条目回答，只对仍缺资料的问题继续查。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "queries": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "maxLength": 1000,
                      "minLength": 1
                    },
                    "max_results": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "search_depth": {
                      "type": "string",
                      "enum": [
                        "basic",
                        "advanced"
                      ]
                    },
                    "include_domains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 253
                      },
                      "maxItems": 20
                    },
                    "exclude_domains": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 253
                      },
                      "maxItems": 20
                    },
                    "domain": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "sub_domain": {
                      "type": "string",
                      "maxLength": 160
                    },
                    "sub_domain_params": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "query"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "queries"
            ],
            "additionalProperties": false
          },
          "aliases": [
            "mcp__anysearch__batch_search"
          ],
          "permissionAliases": [
            "web_search"
          ],
          "mutating": false
        },
        {
          "name": "get_sub_domains",
          "export": "get_sub_domains",
          "description": "使用 AnySearch 的专业数据查询前，查明领域、子领域及必填参数。",
          "scope": "all",
          "permission": "member",
          "cancellation": "cooperative",
          "inputSchema": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "string",
                "maxLength": 80
              },
              "domains": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 80
                },
                "maxItems": 5
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "aliases": [
            "mcp__anysearch__get_sub_domains"
          ],
          "when": {
            "field": "webProvider",
            "equals": "anysearch"
          },
          "permissionAliases": [
            "web_search"
          ],
          "mutating": false
        }
      ],
      "ui": {
        "version": 1,
        "sections": [
          {
            "id": "settings",
            "title": "设置",
            "fields": [
              "customWeb",
              "customImage"
            ]
          }
        ],
        "globalSections": [
          {
            "id": "web",
            "title": "网页搜索",
            "fields": [
              "webProvider"
            ],
            "widgets": [
              {
                "type": "secret",
                "key": "anysearchKey",
                "title": "AnySearch API Key（可选）",
                "when": {
                  "field": "webProvider",
                  "equals": "anysearch"
                }
              },
              {
                "type": "secret",
                "key": "tavilyKey",
                "title": "Tavily API Key",
                "when": {
                  "field": "webProvider",
                  "equals": "tavily"
                }
              },
              {
                "type": "secret",
                "key": "exaKey",
                "title": "Exa API Key",
                "when": {
                  "field": "webProvider",
                  "equals": "exa"
                }
              },
              {
                "type": "secret",
                "key": "braveKey",
                "title": "Brave Search API Key",
                "when": {
                  "field": "webProvider",
                  "equals": "brave"
                }
              }
            ]
          },
          {
            "id": "image",
            "title": "以图搜图",
            "fields": [
              "imageProvider"
            ],
            "widgets": [
              {
                "type": "secret",
                "key": "googleKey",
                "title": "Cloud Vision API Key",
                "when": {
                  "field": "imageProvider",
                  "equals": "google"
                }
              }
            ]
          }
        ],
        "settingsGroups": [
          {
            "mode": "customWeb",
            "sections": [
              "web"
            ],
            "summary": "webProvider"
          },
          {
            "mode": "customImage",
            "sections": [
              "image"
            ],
            "summary": "imageProvider"
          }
        ],
        "chatAudiences": [
          "group:member",
          "group:owner",
          "private:member",
          "private:owner"
        ]
      },
      "metadata": {
        "platforms": [
          "napcat",
          "qqbot"
        ],
        "requirements": [
          "需要 OpenBot 0.1.120 或更高版本。",
          "Google 图片搜索需在已结算的项目启用 Cloud Vision API，并配置允许调用该 API 的 Key。"
        ],
        "usage": "启用插件后直接提问，或发送、引用图片询问出处。",
        "changelog": "支持读取网页轮播里的游戏截图。搜索完成后按结果回复，需要对方辨认画面时发送已核对的图片。配合 OpenBot 0.1.128 可并行搜索和读页。"
      },
      "requiredFeatures": [
        "pluginSettingsGroups",
        "pluginSettingScopes"
      ]
    }
  }
}
